---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Fachada from '../components/Fachada.astro';
import Lateral from '../components/Lateral.astro';
import IndicadorEtiqueta from '../components/IndicadorEtiqueta.astro';
import TarjetaReporte from '../components/TarjetaReporte.astro';
import { b, describirPisos, niveles, pisosPasillo } from '../lib/edificio';

const estilo = b.architectural_style.replace(' / ', ', ');
const reportes = (await getCollection('reportes')).sort((x, y) => y.data.date.valueOf() - x.data.date.valueOf());
const recientes = reportes.slice(0, 3);
const enCurso = reportes.filter((r) => r.data.status !== 'Completado').length;
const completados = reportes.length - enCurso;
---

<Base>
  <section class="hero">
    <div class="contenedor hero-texto">
      <p class="antetitulo">{b.name} · {b.location}</p>
      <h1>Del amarillo al <span class="verde">verde</span>: la recuperación de {b.alias}</h1>
      <p class="bajada">
        Aquí publicamos cada diagnóstico, obra y reparación del edificio, con fotos del antes y el después y sus soportes, para
        que toda la comunidad pueda seguir el avance hacia la etiqueta verde.
      </p>
      <div class="acciones">
        <a class="boton primario" href="#etiqueta">Ver el avance</a>
        <a class="boton" href="/reportes/">Leer los informes</a>
      </div>
    </div>
    <div class="hero-fachada">
      <Fachada id="hero" />
    </div>
    <div class="contenedor">
      <dl class="datos">
        <div><dt>Niveles (PB + pisos)</dt><dd>{niveles.length}</dd></div>
        <div><dt>Módulos en fachada</dt><dd>{b.grid.total_columns}</dd></div>
        <div><dt>Módulos de ascensores</dt><dd>{b.grid.elevator_cores.length}</dd></div>
        <div><dt>Informes publicados</dt><dd>{reportes.length}</dd></div>
      </dl>
    </div>
  </section>

  <section id="etiqueta" class="seccion">
    <div class="contenedor">
      <div class="encabezado">
        <p class="antetitulo">Indicador de etiqueta habitacional</p>
        <h2>¿Cuánto nos falta para la etiqueta verde?</h2>
        <p>Estos son los requisitos que debe cumplir el edificio. Cada uno se marca solo cuando la obra está terminada y documentada.</p>
      </div>
      <IndicadorEtiqueta />
    </div>
  </section>

  <section class="seccion edificio">
    <div class="contenedor edificio-grid">
      <div class="lateral-caja">
        <Lateral id="lateral-inicio" />
        <p class="leyenda">Vista lateral: bloque de apartamentos y torre de escaleras</p>
      </div>
      <div>
        <p class="antetitulo">El edificio</p>
        <h2>{b.alias}</h2>
        <p class="subtitulo">{b.name}</p>
        <p>
          Parte del conjunto urbanístico del 23 de Enero ({estilo}). Tiene planta baja y {niveles.length - 1} pisos, con{' '}
          {pisosPasillo.length} pasillos ({describirPisos(pisosPasillo)}) conectados a {b.grid.elevator_cores.length} módulos de
          ascensores y escaleras.
        </p>
        <ul class="zonas-clave">
          <li><span style="background:#C4405E"></span><strong>Escaleras</strong> Circulación vertical y ruta de evacuación.</li>
          <li><span style="background:#3B6FB6"></span><strong>Columnas</strong> Estructura que sostiene todo el bloque.</li>
          <li><span style="background:#E8B04A"></span><strong>Pasillos</strong> Acceso a los apartamentos en {describirPisos(pisosPasillo)}.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="encabezado fila">
        <div>
          <p class="antetitulo">Últimos informes</p>
          <h2>Diagnósticos y obras</h2>
          <p>{enCurso} en curso · {completados} completados</p>
        </div>
        <a class="boton oscuro" href="/reportes/">Todos los informes →</a>
      </div>
      <div class="rejilla">
        {recientes.map((r) => <TarjetaReporte reporte={r} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background:
      radial-gradient(ellipse at 70% 0%, rgba(255, 215, 0, 0.12), transparent 55%),
      linear-gradient(var(--noche), var(--noche-2));
    color: #fff;
    padding-top: clamp(40px, 7vw, 80px);
    overflow: hidden;
  }
  .hero .antetitulo {
    color: #a3a8b1;
  }
  h1 {
    font-size: clamp(2.3rem, 6.5vw, 4.6rem);
    font-stretch: 75%;
    font-weight: 800;
    margin: 12px 0 18px;
    max-width: 16ch;
  }
  .verde {
    color: #5fd38d;
  }
  .bajada {
    max-width: 60ch;
    color: #c9ccd2;
    font-size: clamp(1rem, 2vw, 1.2rem);
    margin: 0;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .boton {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.3);
  }
  .boton:hover {
    border-color: #fff;
  }
  .boton.primario {
    background: var(--estrella);
    border-color: var(--estrella);
    color: var(--noche);
  }
  .boton.oscuro {
    color: var(--tinta);
    border-color: var(--tinta);
    white-space: nowrap;
  }
  .boton.oscuro:hover {
    background: var(--tinta);
    color: #fff;
  }
  .hero-fachada {
    margin-top: clamp(24px, 4vw, 48px);
    /* funde el cielo con el fondo del encabezado */
    -webkit-mask-image: linear-gradient(transparent, #000 14%);
    mask-image: linear-gradient(transparent, #000 14%);
  }
  @media (max-width: 700px) {
    /* En móvil la escena se recorta centrada en el edificio */
    .hero-fachada :global(svg) {
      height: 440px;
    }
  }
  .datos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    margin: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .datos div {
    padding: 20px 0;
  }
  .datos dt {
    color: #a3a8b1;
    font-size: 0.85rem;
  }
  .datos dd {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 800;
    font-stretch: 75%;
  }

  .encabezado {
    margin-bottom: 32px;
    max-width: 62ch;
  }
  .encabezado h2,
  .edificio h2 {
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    margin: 10px 0 12px;
  }
  .encabezado p {
    color: var(--texto-suave);
    margin: 0;
  }
  .encabezado.fila {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }
  #etiqueta {
    scroll-margin-top: 60px;
  }

  .edificio {
    background: #e9e4d8;
  }
  .edificio-grid {
    display: grid;
    grid-template-columns: minmax(180px, 280px) 1fr;
    gap: clamp(28px, 6vw, 72px);
    align-items: center;
  }
  @media (max-width: 700px) {
    .edificio-grid {
      grid-template-columns: 1fr;
    }
    .lateral-caja {
      max-width: 220px;
      margin-inline: auto;
    }
  }
  .lateral-caja {
    background: var(--noche);
    border-radius: var(--radio);
    padding: 20px 20px 12px;
  }
  .leyenda {
    color: #a3a8b1;
    font-size: 0.82rem;
    text-align: center;
    margin: 10px 0 0;
  }
  .subtitulo {
    margin: -6px 0 16px;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .zonas-clave {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 12px;
  }
  .zonas-clave li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    color: var(--texto-suave);
  }
  .zonas-clave span {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    align-self: center;
  }
  .zonas-clave strong {
    color: var(--tinta);
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }
</style>

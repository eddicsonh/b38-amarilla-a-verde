---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaReporte from '../../components/TarjetaReporte.astro';
import { ESTADOS, ESTADO_COLOR } from '../../lib/constantes';

const reportes = (await getCollection('reportes')).sort((x, y) => y.data.date.valueOf() - x.data.date.valueOf());
const grupos = ESTADOS.map((estado) => ({
  estado,
  items: reportes.filter((r) => r.data.status === estado),
})).filter((g) => g.items.length);
---

<Base title="Informes" description="Todos los diagnósticos, obras y reparaciones del Bloque 38, Zona F, 23 de Enero.">
  <section class="cabecera">
    <div class="contenedor">
      <p class="antetitulo">Seguimiento de obras</p>
      <h1>Informes del edificio</h1>
      <ul class="resumen">
        {ESTADOS.map((e) => (
          <li style={`--c: ${ESTADO_COLOR[e]}`}>
            <strong>{reportes.filter((r) => r.data.status === e).length}</strong> {e}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="contenedor seccion">
    {grupos.length === 0 && <p>Todavía no hay informes publicados.</p>}
    {grupos.map((g) => (
      <section class="grupo">
        <h2 style={`--c: ${ESTADO_COLOR[g.estado]}`}>{g.estado}</h2>
        <div class="rejilla">
          {g.items.map((r) => <TarjetaReporte reporte={r} />)}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .cabecera {
    background: var(--noche);
    color: #fff;
    padding-block: clamp(40px, 7vw, 72px);
  }
  .cabecera .antetitulo {
    color: #a3a8b1;
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-stretch: 75%;
    margin: 10px 0 20px;
  }
  .resumen {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
  }
  .resumen li {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border-left: 5px solid var(--c);
    color: #d4d7dc;
  }
  .resumen strong {
    color: #fff;
    font-size: 1.1rem;
  }
  .grupo + .grupo {
    margin-top: 56px;
  }
  .grupo h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.7rem;
    margin: 0 0 20px;
  }
  .grupo h2::before {
    content: '';
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c);
  }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }
</style>

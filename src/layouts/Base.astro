---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import edificio from '../data/edificio.json';

interface Props {
  title?: string;
  description?: string;
}

const nombre = 'Bloque 38 · 23 de Enero';
const { title, description = `Informes de avances y reparaciones del ${edificio.building.name}, ${edificio.building.location}.` } =
  Astro.props;
const tituloCompleto = title ? `${title} | ${nombre}` : `${nombre} — Informes del edificio`;
const ruta = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14161a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_VE" />
  </head>
  <body>
    <header class="barra">
      <div class="contenedor barra-interior">
        <a class="marca" href="/">
          <svg viewBox="0 0 64 64" width="28" height="28" aria-hidden="true">
            <g fill="rgba(255,215,0,.25)" stroke="#ffd700" stroke-width="4" stroke-linejoin="round">
              <path d="M32 8 53 44H11Z" /><path d="M32 56 11 20h42Z" />
            </g>
          </svg>
          <span><strong>Bloque 38</strong> <span class="marca-zona">Zona F · 23 de Enero</span></span>
        </a>
        <nav aria-label="Principal">
          <a href="/#etiqueta" aria-current={ruta === '/' ? 'page' : undefined}>Etiqueta</a>
          <a href="/reportes/" aria-current={ruta.startsWith('/reportes') ? 'page' : undefined}>Informes</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie-interior">
        <p>
          <strong>{edificio.building.name}</strong><br />
          {edificio.building.location}
        </p>
        <p class="pie-nota">Sitio comunitario de seguimiento de obras. Actualizado por el equipo de mantenimiento del bloque.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(20, 22, 26, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .barra-interior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    font-stretch: 90%;
    line-height: 1.1;
  }
  .marca strong {
    font-size: 1.15rem;
  }
  .marca-zona {
    color: #a3a8b1;
    font-size: 0.85rem;
  }
  nav {
    display: flex;
    gap: 4px;
  }
  nav a {
    color: #d4d7dc;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 6px 12px;
    border-radius: 999px;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  @media (max-width: 480px) {
    .marca-zona {
      display: none;
    }
  }
  .pie {
    background: var(--noche);
    color: #a3a8b1;
    font-size: 0.95rem;
  }
  .pie-interior {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 40px;
    padding-block: 40px;
  }
  .pie strong {
    color: #fff;
  }
  .pie-nota {
    max-width: 42ch;
  }
</style>

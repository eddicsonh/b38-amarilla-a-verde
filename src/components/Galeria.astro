---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Foto {
  src: ImageMetadata;
  pie?: string;
}

interface Props {
  titulo: string;
  fotos: Foto[];
  variante: 'antes' | 'despues';
  vacio: string;
}

const { titulo, fotos, variante, vacio } = Astro.props;

// Versión grande que se abre al tocar cada foto
const grandes = await Promise.all(fotos.map((f) => getImage({ src: f.src, width: 1600, format: 'webp' })));
---

<section class:list={['galeria', variante]}>
  <h3><span class="punto" aria-hidden="true"></span>{titulo} <span class="cuenta">{fotos.length}</span></h3>
  {fotos.length ? (
    <ul>
      {fotos.map((f, i) => (
        <li>
          <figure>
            <a href={grandes[i].src} target="_blank" rel="noopener">
              <Image src={f.src} alt={f.pie ?? titulo} widths={[360, 720]} sizes="(max-width: 700px) 100vw, 360px" loading="lazy" />
            </a>
            {f.pie && <figcaption>{f.pie}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  ) : (
    <p class="vacio">{vacio}</p>
  )}
</section>

<style>
  .galeria {
    --color: var(--rojo);
  }
  .despues {
    --color: var(--verde);
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.4rem;
    margin: 0 0 14px;
  }
  .punto {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color);
  }
  .cuenta {
    font-size: 0.85rem;
    font-weight: 700;
    background: #efebe2;
    border-radius: 999px;
    padding: 1px 9px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 14px;
  }
  figure {
    margin: 0;
  }
  a {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--noche-2);
    outline-offset: 3px;
    border-bottom: 5px solid var(--color);
  }
  a :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  a:hover :global(img) {
    transform: scale(1.04);
  }
  figcaption {
    font-size: 0.88rem;
    color: var(--texto-suave);
    margin-top: 6px;
  }
  .vacio {
    margin: 0;
    padding: 28px 20px;
    text-align: center;
    color: var(--texto-suave);
    border: 2px dashed var(--borde);
    border-radius: 12px;
    background: repeating-linear-gradient(135deg, transparent 0 14px, rgba(47, 158, 91, 0.05) 14px 28px);
  }
</style>

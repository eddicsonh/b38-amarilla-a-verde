---
import etiqueta from '../data/etiqueta.json';

const total = etiqueta.requisitos.length;
const cumplidos = etiqueta.requisitos.filter((r) => r.cumplido).length;
const pct = total ? Math.round((cumplidos / total) * 100) : 0;
---

<div class="indicador">
  <div class="extremos">
    <div class="etiqueta amarilla">
      <span class="chip">Estado actual</span>
      <strong>Etiqueta {etiqueta.estado_actual.etiqueta}</strong>
      <span>{etiqueta.estado_actual.descripcion}</span>
    </div>
    <svg class="flecha" viewBox="0 0 48 24" aria-hidden="true"><path d="M2 12h40m-8-8 8 8-8 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
    <div class="etiqueta verde">
      <span class="chip">Meta</span>
      <strong>Etiqueta {etiqueta.meta.etiqueta}</strong>
      <span>{etiqueta.meta.descripcion}</span>
    </div>
  </div>

  <div class="progreso">
    <div class="progreso-cabecera">
      <span><strong class="pct">{pct}%</strong> del camino</span>
      <span>{cumplidos} de {total} requisitos cumplidos</span>
    </div>
    <div
      class="pista"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow={pct}
      aria-label="Avance hacia la etiqueta verde"
      style={`--pct: ${pct}%`}
    >
      <div class="relleno"></div>
      {etiqueta.requisitos.map((_, i) => i > 0 && <span class="marca" style={`left: ${(i / total) * 100}%`}></span>)}
    </div>
  </div>

  <ul class="checklist">
    {etiqueta.requisitos.map((r) => (
      <li class:list={[{ hecho: r.cumplido }]}>
        <span class="check" aria-hidden="true">
          {r.cumplido ? (
            <svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
          ) : null}
        </span>
        <span class="sr-only">{r.cumplido ? 'Cumplido:' : 'Pendiente:'}</span>
        <span class="texto">
          {r.reporte ? <a href={`/reportes/${r.reporte}/`}>{r.texto}</a> : r.texto}
        </span>
        <span class="estado">{r.cumplido ? 'Listo' : 'Pendiente'}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .indicador {
    display: grid;
    gap: 28px;
  }
  .extremos {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 12px;
  }
  .flecha {
    width: 40px;
    align-self: center;
    color: var(--texto-suave);
  }
  .etiqueta {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 20px;
    border-radius: var(--radio);
    color: var(--tinta);
    position: relative;
    overflow: hidden;
  }
  .etiqueta strong {
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    font-stretch: 80%;
    line-height: 1.1;
  }
  .etiqueta span:last-child {
    font-size: 0.95rem;
  }
  .amarilla {
    background: #ffd84d;
  }
  .verde {
    background: #bfe8cf;
    border: 2px dashed var(--verde);
  }
  .chip {
    justify-self: start;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.1);
    padding: 2px 8px;
    border-radius: 999px;
  }
  @media (max-width: 640px) {
    .extremos {
      grid-template-columns: 1fr;
    }
    .flecha {
      transform: rotate(90deg);
      justify-self: center;
    }
  }

  .progreso-cabecera {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-bottom: 10px;
    color: var(--texto-suave);
  }
  .pct {
    font-size: 2.4rem;
    font-stretch: 75%;
    color: var(--tinta);
    line-height: 1;
  }
  .pista {
    position: relative;
    height: 22px;
    border-radius: 999px;
    background: #e6e1d6;
    overflow: hidden;
  }
  .relleno {
    height: 100%;
    width: var(--pct);
    border-radius: inherit;
    background: linear-gradient(90deg, #f2b705, #9cc43a 70%, #2f9e5b);
    animation: llenar 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .marca {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    margin-left: -1.5px;
    background: var(--papel);
  }
  @keyframes llenar {
    from {
      width: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .relleno {
      animation: none;
    }
  }

  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .checklist li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: 12px;
  }
  .check {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 2.5px solid #b9b3a6;
    color: #fff;
  }
  .check svg {
    width: 20px;
  }
  .hecho .check {
    background: var(--verde);
    border-color: var(--verde);
  }
  .hecho .texto {
    color: var(--texto-suave);
  }
  .estado {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: 999px;
    background: #fbe7ec;
    color: #9b2743;
  }
  .hecho .estado {
    background: #dcf2e4;
    color: #1f7442;
  }
</style>
